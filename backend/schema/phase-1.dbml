// Ascentis Consultant Database App — Phase 1
// Dataverse schema for dbdiagram.io
// Source: URS QMS-ASC-PMC-URS-CODBAPPH1 R0 §6 · FS QMS-ASC-PMC-SPC-CODBAPPH1 R0 §2

//////////////////////////////////////////////
// USERS & ROLES  (URS §4 RBAC)
//////////////////////////////////////////////

Table appuser {
  id uuid [pk]
  asc_name varchar [not null, note: 'Full name']
  asc_email varchar [not null, unique]
  asc_role varchar [note: 'Admin / Lead Reviewer / Data editor / Rater / KAM Lead / Key Account Manager / All app users / Super User / Consultant Primary Contact']
  asc_systemuser_id uuid [note: 'lookup to systemuser — links this profile row to the native Dataverse user account']

  Note: 'New table. Custom user/role reference per URS §4 RBAC. The existing asc_leadreviewer_id, asc_kam_id, asc_rater_id and asc_reviewedby_id lookups on other tables continue to reference systemuser directly, not this table, pending a later decision on whether to repoint them here.'
}

//////////////////////////////////////////////
// CORE
//////////////////////////////////////////////

Table consultant {
  id uuid [pk]
  asc_name varchar [not null, note: 'Primary column. Duplicate check by email domain.']
  asc_akaname varchar
  asc_website varchar
  asc_firmtype_id uuid [ref: > firmtype.id]
  asc_status varchar [not null, note: 'Active / Inactive / Blacklisted. Live drift 2026-10-08: converted to a real required Choice column (global option set asc_consultantstatus, Active=751050000/Inactive=751050001/Blacklisted=751050002) - was previously free text. Admin/internal-controlled; the portal only ever sets Active, once, at Create - see services.js saveConsultant().']
  asc_workedwithus boolean [note: 'calculated: true if any Engagement exists']
  asc_completeness decimal [note: 'calculated across all fields']
  asc_leadreviewer_id uuid [note: 'lookup to systemuser — drives Access Team grant']
  asc_kam_id uuid [note: 'lookup to systemuser — optional']
  asc_revenuepct_southasia decimal
  asc_revenuepct_middleeast decimal
  asc_revenuepct_africa decimal
  asc_revenuepct_other decimal
  asc_bimcapability varchar [not null, note: 'In-house / Outsourced']
  asc_bimoperatorcount int [note: 'required if in-house']
  asc_confackn boolean [note: 'confidentiality statement acknowledged']
  asc_confacknby varchar
  asc_confackndate datetime
  asc_lastupdated_overview datetime
  asc_lastupdated_financial datetime
  asc_lastupdated_legal datetime
  asc_lastupdated_esg datetime

  Note: 'Hub table. Record ownership: User or team. Live drift 2026-10-08: asc_effectiveyear/asc_fiscalformat/asc_backloginhand/asc_revenuen1-3/asc_backlogratio/asc_indemnified/asc_indemnitydetails/asc_litigation/asc_litigationdetails/asc_holdspi/asc_piperoccurrence/asc_piaggregate/asc_esgcert/asc_esgcertdetails/asc_esgreporting/asc_esgframework/asc_accreditedcount/asc_esgqa/asc_esgqadetails were REMOVED entirely (not left in place alongside the child tables, contrary to what financialinformation/legalinformation/sustainabilityesg below originally assumed when they were added 16 Sept 2026) - confirmed via a fresh pac solution export after this caused every portal save to 400 ("Common Data Service error occurred", a column no longer existing in a $select or write body). The dedicated child tables below are now the sole source for this data; asc_statuscomment (SECURED field) still exists live but unused by the portal, not documented above.'
}

//////////////////////////////////////////////
// CONSULTANT SUB-PROFILES  (new tables, URS §6.6/6.7/6.9/6.10 — 1:1 or per-year,
// alongside the existing flattened columns on consultant, not replacing them yet)
//////////////////////////////////////////////

Table consultanttabupdate {
  id uuid [pk]
  asc_name varchar [not null, note: 'Record display name; generated by the trusted application service.']
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_tab varchar [not null, note: 'Which profile tab this record tracks']
  asc_updatedby_id uuid [note: 'lookup to systemuser']
  asc_updatedon datetime

  Note: 'New table. Per-tab last-updated tracking required by URS §6.2 "Last updated (per tab)" for any tab, not only overview/financial/legal/esg. The existing 4 fixed asc_lastupdated_* columns on consultant are left in place, not removed, pending a later cleanup decision.'
}

Table financialinformation {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_effectiveyear int [not null]
  asc_fiscalformat varchar [note: 'YYYY or YYYY/ZZ']
  asc_backloginhand decimal [note: 'Currency, USD-locked']
  asc_revenuen1 decimal [not null, note: 'Currency, USD-locked']
  asc_revenuen2 decimal
  asc_revenuen3 decimal
  asc_backlogratio decimal [note: 'calculated %']

  Note: 'Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber), same pattern as biminformation/contact/etc. Per-year financial record (URS §6.6), enabling year-over-year history that the flattened consultant columns could not hold. 2026-10-08: the equivalent columns on consultant were removed entirely (not left in place as originally assumed) - this is now the sole live source for Financial tab data, wired into the portal frontend via dataverse-map.json childTables.financial / services.js saveChildTable().'
}

Table financialrevenueregion {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_financialinformation_id uuid [not null, ref: > financialinformation.id]
  asc_region_id uuid [not null, ref: > region.id]
  asc_revenuepct decimal

  Note: 'Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber). Deleted live by the user in the maker portal; this defines its replacement. Open-ended revenue-by-region rows (URS §6.6 "Revenue % by region"), replacing the fixed asc_revenuepct_* columns on consultant with one row per region instead of one column per region. Those columns are left in place, not removed, pending a later cleanup decision. Not referenced anywhere in the portal frontend.'
}

Table legalinformation {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, unique, ref: - consultant.id, note: '1:1']
  asc_indemnified boolean [not null]
  asc_indemnitydetails text [note: 'required if indemnified = true']
  asc_litigation boolean [not null]
  asc_litigationdetails text [note: 'required if litigation = true']
  asc_holdspi boolean [not null]
  asc_piperoccurrence decimal [note: 'required if holdspi = true']
  asc_piaggregate decimal [note: 'required if holdspi = true']

  Note: 'Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber). 1:1 legal child table per URS §6.7. 2026-10-08: the equivalent flattened columns on consultant were removed entirely (not left in place as originally assumed) - this is now the sole live source for Legal tab data, wired into the portal frontend via dataverse-map.json childTables.legal / services.js saveChildTable().'
}

Table biminformation {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, unique, ref: - consultant.id, note: '1:1']
  asc_bimcapability varchar [not null, note: 'In-house / Outsourced. Plain text here - user will convert to a picklist manually in the maker portal afterward, as done on the original table.']
  asc_bimdiscipline uuid [ref: > discipline.id, note: 'Live drift addition, not in the original design - preserved on rebuild to match the prior live shape.']
  asc_bimoperatorcount int [note: 'required if in-house']

  Note: 'Recreated 2026-09-27 (delete + recreate, not a rename) to fix a primary-column schema-name mismatch on the original table: display name "Number" but schema name asc_name, not asc_number - Dataverse cannot rename a schema name after creation. Deleted live by the user in the maker portal; this defines its replacement. 1:1 BIM capability table per URS §6.9, distinct from the per-project bimproject child table. The equivalent flattened columns on consultant are left in place, not removed, pending a later cleanup decision.'
}

Table sustainabilityesg {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, unique, ref: - consultant.id, note: '1:1']
  asc_esgcert boolean [not null]
  asc_esgcertdetails text [note: 'required if esgcert = true']
  asc_esgreporting boolean [not null]
  asc_esgframework text [note: 'required if esgreporting = true']
  asc_accreditedcount int
  asc_esgqa boolean [not null]
  asc_esgqadetails text [note: 'required if esgqa = true']

  Note: 'Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber). 1:1 Sustainability & ESG table per URS §6.10. 2026-10-08: the equivalent flattened columns on consultant were removed entirely (not left in place as originally assumed) - this is now the sole live source for Sustainability tab data, wired into the portal frontend via dataverse-map.json childTables.sustainability / services.js saveChildTable().'
}

//////////////////////////////////////////////
// PROFILE CHILDREN
//////////////////////////////////////////////

Table office {
  id uuid [pk]
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_region_id uuid [not null, ref: > region.id]
  asc_address text
  asc_country varchar [not null]
  asc_headcount int
  asc_leader1_id uuid [ref: > contact.id]
  asc_leader2_id uuid [ref: > contact.id]
  asc_leader3_id uuid [ref: > contact.id]
}

Table officeleader {
  id uuid [pk]
  asc_name varchar [not null, note: 'Record display name; generated by the trusted application service.']
  asc_office_id uuid [not null, ref: > office.id]
  asc_leadernumber int [not null, note: '1 to 3']
  asc_position varchar
  asc_email varchar
  asc_phone varchar

  Note: 'New table. Flexible named-leader child per URS §6.3, alongside the existing office.asc_leader1/2/3_id lookup-to-contact fields (left in place, not removed, pending a later cleanup decision). Use this table where a leader needs their own position/email/phone rather than being an existing Contact record.'
}

Table contact {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_firstname varchar [not null]
  asc_lastname varchar [not null]
  asc_workemail varchar [not null, unique]
  asc_phone varchar [not null]
  asc_jobtitle varchar
  asc_regionid uuid [ref: > region.id, note: 'Live drift: was free-text asc_region, replaced by this lookup. Preserved on rebuild to match the prior live shape.']
  asc_contacttype varchar [not null, note: 'Senior leader / Project contact / Primary contact. Plain text on rebuild - user will convert to a picklist manually in the maker portal afterward, as done on the original table.']
  asc_status varchar [not null, note: 'Active / Inactive. Plain text on rebuild - user will convert to a picklist manually in the maker portal afterward, as done on the original table.']

  Note: 'Recreated 2026-09-27 (delete + recreate, not a rename) to fix a primary-column schema-name mismatch on the original table, same as biminformation the same day. Deleted live by the user in the maker portal; this defines its replacement. asc_name (which held a firstName+lastName synthesis) is dropped - asc_firstname/asc_lastname already carry that identity, so it was redundant.'
}

Table shareholder {
  id uuid [pk]
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_name varchar [not null]
  asc_equitypct decimal [not null, note: 'siblings should sum to ~100%']
}

Table operatorapproval {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_operator_id uuid [not null, ref: > operator.id]
  asc_brands varchar
  Note: 'Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber). Deleted live by the user in the maker portal; this defines its replacement. Max 8 rows per Consultant (business rule). Not referenced anywhere in the portal frontend.'
}

Table operatorapprovaldiscipline {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_operatorapproval_id uuid [not null, ref: > operatorapproval.id]
  asc_disciplineid uuid [not null, ref: > discipline.id]

  Note: 'New table, requested 2026-09-28. Explicit Operator Approval x Discipline junction, alongside the existing operatorapproval_discipline N:N relationship (left in place, unused - same pattern as the Consultant x Discipline/Sector/Region junction tables added 2026-09-27) so this association is stored as real, queryable rows instead of only Dataverse hidden N:N intersect data. Not referenced anywhere in the portal frontend.'
}

Table projectreference {
  id uuid [pk]
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_name varchar [not null]
  asc_country varchar [not null]
  asc_region_id uuid [not null, ref: > region.id]
  asc_type varchar [not null, note: 'Hotel / Mixed-use / Residential / Commercial / …']
  asc_brand varchar [note: 'hotels only']
  asc_gfa int [note: 'mandatory for non-hotel']
  asc_keys int [note: 'hotels only']
  asc_projectstatus varchar [not null, note: 'In progress / Completed / On hold / Cancelled. Documentation-only rename to asc_projectstatus on 20 Sept 2026, matching an already-live rename observed via export - this file did not cause that live change and no live Dataverse write was made here.']
  asc_startyear int [not null]
  asc_completionyear int [note: 'required only when Completed']
  asc_attachment_id uuid [ref: > attachment.id]
  Note: 'Max 30 rows per Consultant (business rule)'
}

Table projectreferencetype {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_projectreference_id uuid [not null, ref: > projectreference.id]
  asc_projecttype_id uuid [not null, ref: > projecttype.id]

  Note: 'New table, requested 2026-09-28. Explicit Project Reference x Project Type junction - the intended resolver for projectreference.asc_type once asc_projecttype has real seeded rows (see dataverse-map.json referenceLookupColumns). Not referenced anywhere in the portal frontend.'
}

Table bimproject {
  id uuid [pk]
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_name varchar [not null]
  asc_location varchar [not null]
  asc_gfa int [not null]
  asc_lod varchar [not null, note: 'Level of Development']
  Note: 'Max 10 rows per Consultant (business rule)'
}

Table note {
  id uuid [pk]
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_category varchar [not null, note: 'Strength / Weakness / Availability / General']
  asc_comment text [not null]
  createdby uuid [note: 'system column — native author/audit']
  createdon datetime [note: 'system column — native audit']

  Note: 'Create/Edit field-security restricted to Lead Reviewer + Admin. Delete = Admin only (table privilege).'
}

Table attachment {
  id uuid [pk]
  asc_file varchar [not null, note: 'File column, 25 MB cap']
  asc_documenttype_id uuid [ref: > documenttype.id]
  asc_consultant_id uuid [ref: > consultant.id, note: 'nullable — exactly one of consultant/contact/projectreference set']
  asc_contact_id uuid [ref: > contact.id, note: 'nullable — exactly one of consultant/contact/projectreference set']
  asc_projectreference_id uuid [ref: > projectreference.id, note: 'nullable — exactly one of consultant/contact/projectreference set. Additive column: aligns with URS §6.14/§6.8, which links the attachment to the owning project reference. The existing projectreference.asc_attachment_id reverse link is deprecated in favour of this forward link; remove it in a later cleanup once no data depends on it — not removed here.']
  asc_filename varchar [note: 'Original uploaded file name. Additive column: URS §6.14 "File / document type".']
  asc_filesizemb decimal [note: 'File size in MB. Additive column: URS §6.14 "Uploader / date", max 25 MB enforced at the trusted layer.']
  asc_uploadedby_id uuid [note: 'lookup to systemuser — uploader. Additive column: URS §6.14 "Uploader / date".']
  asc_uploadedon datetime [note: 'Upload timestamp. Additive column: URS §6.14 "Uploader / date".']
}

//////////////////////////////////////////////
// ENGAGEMENTS & RATINGS  (hidden from portal)
//////////////////////////////////////////////

Table engagement {
  id uuid [pk]
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_projectname varchar [not null]
  asc_clientname varchar [not null]
  asc_country varchar [not null]
  asc_city varchar [not null]
  asc_status varchar [not null, note: 'Ongoing / Completed']
  asc_startdate date
  asc_enddate date

  Note: 'Never exposed to the portal — no Table Permission configured for the Consultant web role.'
}

Table rating {
  id uuid [pk]
  asc_engagement_id uuid [not null, ref: > engagement.id]
  asc_criteria1 int [not null, note: '1-4, Adherence to timeline']
  asc_criteria2 int [not null, note: '1-4, Quality of drawings']
  asc_criteria3 int [not null, note: '1-4, Creativity / aesthetics']
  asc_criteria4 int [not null, note: '1-4, Functional optimization']
  asc_criteria5 int [not null, note: '1-4, Cost awareness']
  asc_criteria6 int [not null, note: '1-4, Lead role in coordination']
  asc_criteria7 int [not null, note: '1-4, Responsiveness']
  asc_overallscore decimal [note: 'calculated: average of the 7, 1dp']
  asc_comment text [not null]
  asc_rater_id uuid [note: 'lookup to systemuser']
  asc_ratertext varchar [note: 'copied name — survives user deletion']
  asc_ratingdate datetime
  asc_workflowstatus varchar [not null, note: 'Submitted / Approved / To be Revised']
  asc_locked boolean [note: 'calculated: true on approval']

  Note: 'One row per dated rating set. Latest by asc_ratingdate is the displayed set; earlier rows read-only.'
}

Table ratingscore {
  id uuid [pk]
  asc_name varchar [not null, note: 'Record display name; generated by the trusted application service.']
  asc_rating_id uuid [not null, ref: > rating.id]
  asc_ratingcriterion_id uuid [not null, ref: > ratingcriterion.id]
  asc_score int [not null, note: '1-4, Poor/Average/Good/Excellent']

  Note: 'New table. Extensible per-criterion score (URS §6.11 Rating sub-section), replacing the fixed asc_criteria1-7 columns on rating with one row per criterion. Those columns are left in place, not removed, pending a later cleanup decision. Requires ratingcriterion seeded with the 7 fixed criteria (Appendix A) first.'
}

Table engagementcontact {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_engagement_id uuid [not null, ref: > engagement.id]
  asc_contactid uuid [not null, ref: > contact.id, note: 'Live column name has no underscore before id, unlike this schema file's previous asc_contact_id - corrected to match reality on this rebuild.']
  asc_role varchar [note: 'Role this contact played on the engagement — URS §6.11 "Consultant contacts & roles".']

  Note: 'Recreated 2026-09-30 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber). Deleted live by the user in the maker portal; this defines its replacement. Replaces the former asc_engagement_contact N:N relationship (a plain Dataverse N:N cannot carry the Role attribute required by URS §6.11) - that N:N stays defined but unused. Not referenced anywhere in the portal frontend.'
}

Table consultantdiscipline {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), generated on create. Do not supply a value when writing.']
  asc_consultantid uuid [not null, ref: > consultant.id]
  asc_disciplineid uuid [not null, ref: > discipline.id]

  Note: 'Pre-existing live table, not created by this schema - discovered on 2026-09-27 when a solution import attempting to create a new asc_consultantdiscipline table for this exact purpose collided with one already live (built manually in the maker portal at some earlier point, outside this schema''s history). Documented here to match reality, not to declare intent. Entity set: asc_consultantdisciplines. Primary key: asc_consultantdisciplineid. Coexists with (and, per project decision, is now used instead of) the asc_consultant_discipline N:N relationship, which stays defined but unused going forward.'
}

Table consultantsectors {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber, generated on create. Do not supply a value when writing.']
  asc_consultantid uuid [not null, ref: > consultant.id]
  asc_sectorid uuid [not null, ref: > sector.id]

  Note: 'Pre-existing live table, not created by this schema - same discovery as consultantdiscipline on 2026-09-27. Entity set: asc_consultantsectorses (double-plural, not a typo - that is the table''s real live entity set name). Primary key: asc_consultantsectorsid. Coexists with (and now replaces, per project decision) the asc_consultant_sector N:N relationship.'
}

Table consultantregions {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber, generated on create. Do not supply a value when writing.']
  asc_consultantid uuid [not null, ref: > consultant.id]
  asc_regionid uuid [not null, ref: > region.id]

  Note: 'Pre-existing live table, not created by this schema - same discovery as consultantdiscipline on 2026-09-27. Entity set: asc_consultantregionses (double-plural, not a typo). Primary key: asc_consultantregionsid. Coexists with (and now replaces, per project decision) the asc_consultant_region N:N relationship.'
}

//////////////////////////////////////////////
// KAM — CONFIDENTIAL
//////////////////////////////////////////////

Table kamprofile {
  id uuid [pk]
  asc_consultant_id uuid [not null, unique, ref: - consultant.id, note: '1:1']
  asc_designintegrity int [note: '1-4']
  asc_clientmanagement int [note: '1-4']
  asc_stakeholdermgmt int [note: '1-4']
  asc_commercialrecip int [note: '1-4']
  asc_comarketingdriver int [note: '1-4']

  Note: 'CONFIDENTIAL. Zero table privilege for Lead Reviewer / Data Editor / Rater / General User.'
}

Table kamdriverrating {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_kamdriver_id uuid [not null, ref: > kamdriver.id]
  asc_rating int [note: '1 (not important) to 4 (very important)']

  Note: 'CONFIDENTIAL. Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber). Deleted live by the user in the maker portal; this defines its replacement. Extensible per-driver rating (URS §6.13 sub-section 1), replacing the fixed columns on kamprofile with one row per driver. Those columns are left in place, not removed, pending a later cleanup decision. Requires kamdriver seeded with the 5 fixed drivers first. Not referenced anywhere in the portal frontend.'
}

Table kamleadreceived {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_leaddate date [not null]
  asc_projectname varchar [not null]
  asc_clientname varchar [not null]
  asc_referraltype varchar [not null]
  asc_referralcomment varchar
  asc_leadowner varchar [not null]
  asc_services varchar
  asc_leadstatus varchar

  Note: 'CONFIDENTIAL. Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber). Deleted live by the user in the maker portal; this defines its replacement. Not referenced anywhere in the portal frontend.'
}

Table kamleadshared {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_leaddate date [not null]
  asc_projectname varchar [not null]
  asc_referraltype varchar [not null, note: 'incl. Prequalification']
  asc_referralcomment varchar
  asc_leadowner varchar [not null]
  asc_servicesproposed varchar
  asc_referralstatus varchar

  Note: 'CONFIDENTIAL. Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber). Deleted live by the user in the maker portal; this defines its replacement. Not referenced anywhere in the portal frontend.'
}

Table kamcomarketing {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_description varchar [not null]
  asc_status varchar
  asc_statusdate date [note: 'auto, set on entry']

  Note: 'CONFIDENTIAL. Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber). Deleted live by the user in the maker portal; this defines its replacement. Not referenced anywhere in the portal frontend.'
}

//////////////////////////////////////////////
// WORKFLOW SUPPORT
//////////////////////////////////////////////

Table portalsubmission {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_tab varchar [not null, note: 'which of the 8 portal tabs']
  asc_before text [note: 'JSON snapshot']
  asc_after text [note: 'JSON snapshot']
  asc_status varchar [not null, note: 'Draft / Submitted / Accepted / Rejected']
  asc_reviewedby_id uuid [note: 'lookup to systemuser']
  asc_revieweddate datetime
  asc_submittedby_id uuid [ref: > contact.id, note: 'Required for Contact-scoped Table Permissions per docs/portal-submission-configuration.md Step 2.']
  asc_rejectreason text [note: 'docs/portal-submission-configuration.md specifies 500 chars; this build tooling only supports its standard 4000-char text columns (well within bounds, not exactly 500). Required only when asc_status = Rejected.']

  Note: 'Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name/type inconsistency with the other rebuilt tables (asc_number/autonumber, matching biminformation/contact/consultationcategory), and to close the schema gap docs/portal-submission-configuration.md flagged (asc_submittedby, asc_rejectreason, Draft status) in the same pass. Deleted live by the user in the maker portal; this defines its replacement. Not yet written to by the portal frontend - services.js bypasses the draft/review workflow entirely (see its header comment), so there was no code dependency to update.'
}

Table invitation {
  id uuid [pk]
  asc_consultant_id uuid [not null, ref: > consultant.id]
  asc_token varchar [not null, unique]
  asc_issuedon datetime [not null]
  asc_expireson datetime [not null]
  asc_revoked boolean
  asc_purpose varchar [not null, note: 'Onboarding / Update / Revalidation']
}

//////////////////////////////////////////////
// REFERENCE LISTS  (Organization-owned, Admin-maintained — URS §6.15)
//////////////////////////////////////////////

Table discipline {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'Design discipline classification. Ownership: Organization.'
}

Table sector {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'Market segment classification. Ownership: Organization.'
}

Table region {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'South Asia / Middle East / Europe / Africa / Other. Ownership: Organization.'
}

Table operator {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'International hotel/brand operators. Ownership: Organization.'
}

Table service {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'Ownership: Organization.'
}

Table certificationtype {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'LEED AP, WELL AP, BREEAM AP, etc. Ownership: Organization.'
}

Table firmtype {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'Sole Proprietor / Partnership / Private / Public. Ownership: Organization.'
}

Table documenttype {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'Ownership: Organization.'
}

Table consultationcategory {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']

  Note: 'Recreated 2026-09-28 (delete + recreate, not a rename) to fix a primary-column schema-name mismatch on the original table: display name "Name" but schema name asc_newcolumn (never customized after creation), same pattern as biminformation/contact on 2026-09-27. Deleted live by the user in the maker portal; this defines its replacement. Not created by this schema originally - discovered as live drift (asc_note.asc_category was replaced by an asc_categoryid lookup pointing here) with no other columns built out yet, not referenced anywhere in the portal frontend.'
}

Table projecttype {
  id uuid [pk]
  asc_projecttypename varchar [not null, note: 'Primary name field - single line text (not autonumber, unlike every other table rebuilt 2026-09-28), display name "Project Type Name". Holds the actual project-type value (e.g. Hotel, Residential, Mixed-use) directly, so this IS the real lookup target for projectreference.asc_type once seeded.']

  Note: 'Recreated a second time 2026-09-28 (delete + recreate, not a rename) - first rebuild gave it an asc_number autonumber primary matching every other table fixed that day, but the user then asked specifically for a single-line-text primary named Project Type Name instead, since this table's whole purpose is to hold the project-type value itself. Deleted live by the user in the maker portal; this defines its replacement. Seeding rows and wiring projectreference.asc_type to it is still a separate later task.'
}

Table lod {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']

  Note: 'Recreated 2026-09-28 (delete + recreate, not a rename) to fix an unfinished primary column (schema name still asc_newcolumn, display still "New column" - never customized at all). Deleted live by the user in the maker portal; this defines its replacement. Not created by this schema originally - discovered as live drift, likely intended as the missing replacement for bimProjects.lod (see dataverse-map.json unresolvedLiveGaps - "Required by URS §6.9 LOD... Yes. Removed live with no replacement found"). No other columns built out yet; wiring it up as that replacement is a separate later task, not part of this primary-column fix.'
}

Table duplicateoverride {
  id uuid [pk]
  asc_number varchar [not null, note: 'Primary name field - Dataverse autonumber ({SEQNUM:4}), display name "Number", generated on create. Do not supply a value when writing.']
  asc_consultantid uuid [ref: > consultant.id, note: 'Live column name has no underscore before id, unlike most other lookups in this schema - preserved exactly as found.']
  asc_justification text
  asc_matchedvalue varchar
  asc_recordtype varchar [note: 'Live picklist on the original table - plain text on rebuild, user will convert to a picklist manually in the maker portal afterward, as done on the other rebuilt tables.']

  Note: 'Recreated 2026-09-28 (delete + recreate, not a rename) to fix an unfinished primary column (schema name still asc_newcolumn, display still "New column" - never customized at all). Deleted live by the user in the maker portal; this defines its replacement. Not created by this schema originally - discovered as live drift, with 4 real columns already built out (unlike lod/projecttype) suggesting active use for duplicate-consultant-detection overrides; not referenced anywhere in the portal frontend.'
}

Table country {
  id uuid [pk]
  asc_name varchar [not null]
  asc_region_id uuid [ref: > region.id]
  asc_sortorder int
  Note: 'New table. Implied by URS §6.3 "Country Lk". Not among the 8 lists explicitly named in §6.15 — added for referential integrity. The existing office.asc_country / projectreference.asc_country free-text columns are left in place, not converted to a lookup, pending a later decision.'
}

Table ratingcriterion {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'New table. Admin-maintainable list of the 7 rating criteria (Appendix A) for use by ratingscore. URS describes these as fixed, not one of the 8 lists named in §6.15 — confirm before relying on this as editable.'
}

Table kamdriver {
  id uuid [pk]
  asc_name varchar [not null]
  asc_sortorder int
  Note: 'New table. Admin-maintainable list of the 5 KAM key drivers (URS §6.13 sub-section 1) for use by kamdriverrating. Same caveat as ratingcriterion — URS describes these as fixed.'
}

//////////////////////////////////////////////
// N:N JUNCTIONS  (Dataverse intersect tables)
//////////////////////////////////////////////

Table consultant_discipline {
  consultant_id uuid [ref: > consultant.id]
  discipline_id uuid [ref: > discipline.id]
}

Table consultant_sector {
  consultant_id uuid [ref: > consultant.id]
  sector_id uuid [ref: > sector.id]
}

Table consultant_region {
  consultant_id uuid [ref: > consultant.id]
  region_id uuid [ref: > region.id]
  Note: 'Eligible only with an active Office in the Region or ≥3 completed Project References there'
}

Table operatorapproval_discipline {
  operatorapproval_id uuid [ref: > operatorapproval.id]
  discipline_id uuid [ref: > discipline.id]
}

Table operatorapproval_region {
  operatorapproval_id uuid [ref: > operatorapproval.id]
  region_id uuid [ref: > region.id]
}

Table projectreference_discipline {
  projectreference_id uuid [ref: > projectreference.id]
  discipline_id uuid [ref: > discipline.id]
  Note: 'Scope of services'
}

Table bimproject_discipline {
  bimproject_id uuid [ref: > bimproject.id]
  discipline_id uuid [ref: > discipline.id]
}

Table engagement_discipline {
  engagement_id uuid [ref: > engagement.id]
  discipline_id uuid [ref: > discipline.id]
  Note: 'Discipline / role served on this engagement'
}

