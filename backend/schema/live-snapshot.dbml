Table asc_bimproject_discipline {
  asc_bimproject_id uuid [ref: > asc_bimproject.id]
  asc_discipline_id uuid [ref: > asc_discipline.id]
}

Table asc_consultant_bimdiscipline {
  asc_consultant_id uuid [ref: > asc_consultant.id]
  asc_discipline_id uuid [ref: > asc_discipline.id]
}

Table asc_consultant_discipline {
  asc_consultant_id uuid [ref: > asc_consultant.id]
  asc_discipline_id uuid [ref: > asc_discipline.id]
}

Table asc_consultant_region {
  asc_consultant_id uuid [ref: > asc_consultant.id]
  asc_region_id uuid [ref: > asc_region.id]
}

Table asc_consultant_sector {
  asc_consultant_id uuid [ref: > asc_consultant.id]
  asc_sector_id uuid [ref: > asc_sector.id]
}

Table asc_engagement_contact {
  asc_engagement_id uuid [ref: > asc_engagement.id]
  asc_contact_id uuid [ref: > asc_contact.id]
}

Table asc_engagement_discipline {
  asc_engagement_id uuid [ref: > asc_engagement.id]
  asc_discipline_id uuid [ref: > asc_discipline.id]
}

Table asc_operatorapproval_discipline {
  asc_operatorapproval_id uuid [ref: > asc_operatorapproval.id]
  asc_discipline_id uuid [ref: > asc_discipline.id]
}

Table asc_operatorapproval_region {
  asc_operatorapproval_id uuid [ref: > asc_operatorapproval.id]
  asc_region_id uuid [ref: > asc_region.id]
}

Table asc_projectreference_discipline {
  asc_projectreference_id uuid [ref: > asc_projectreference.id]
  asc_discipline_id uuid [ref: > asc_discipline.id]
}

